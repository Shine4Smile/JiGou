spring:
  # mysql
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/jigou
    username: <your username>
    password: <your password>
  # redis
  data:
    redis:
      host: localhost
      port: 6379
      database: 0
      password:
      ttl: 3600
# AI
langchain4j:
  open-ai:
    chat-model:
      base-url: https://api.deepseek.com
      api-key: <Your API Key>
      model-name: deepseek-chat
      max-tokens: 8192
      log-requests: true
      log-responses: true
    streaming-chat-model:
      base-url: https://api.deepseek.com
      api-key: <Your API Key>
      model-name: deepseek-chat
      max-tokens: 8192
      log-requests: true
      log-responses: true
    # 推理 AI 模型配置（用于复杂的推理任务）
    reasoning-streaming-chat-model:
      base-url: https://api.deepseek.com
      api-key: <Your API Key>
      model-name: deepseek-reasoner
      max-tokens: 32768
      temperature: 0.1
      log-requests: true
      log-responses: true
    # 智能路由 AI 模型配置
    routing-chat-model:
      base-url: https://api.deepseek.com
      api-key: <Your API Key>
      model-name: deepseek-chat
      max-tokens: 100
      log-requests: true
      log-responses: true

# Dubbo 注册中心（含账号密码，属于本地私有配置）
dubbo:
  registry:
    address: nacos://127.0.0.1:8848?username=<your username>&password=<your password>
    register-mode: instance # 保持你原有的应用级服务发现配置
    parameters:
      register-consumer-url: "true" # 开启消费者 URL 注册，消除日志黄色提示，方便排查

# =============================================================================
# 存储目录与对外访问地址（模板：复制为 application-dev.yml 后按本机实际情况修改）
#
# storage.root     —— 本机【目录】：必须等于 Nginx 里 tmp 的上一级目录
# deploy.base-url  —— 对外【URL】：= Nginx 的访问地址（浏览器 + 截图机都要能访问）
#
# 本地开发示例（app 与 screenshot 同机）：
#   storage.root:    D:/path/to/JiGou
#   deploy.base-url: http://localhost
# =============================================================================
jigou:
  storage:
    root: D:/path/to/JiGou          # 本机存储根目录，必须与 Nginx 的 root/alias 一致
  deploy:
    base-url: http://localhost      # 已部署应用的对外地址（浏览器 + 截图机都要能访问）
